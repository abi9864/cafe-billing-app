PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cafe_billing
DB_USER=postgres
DB_PASSWORD=password

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads/

# Razorpay (Test mode keys — get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Low-stock alert emails (optional — alerts are skipped with a log warning if unset)
# Example using a Gmail account: create an "App Password" at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_alert_account@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_alert_account@gmail.com
ALERT_EMAIL_TO=manager@cafebillingapp.com
